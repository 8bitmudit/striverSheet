{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "cmd.exe",
            "args": [
                "/c",
                "g++ -std=c++17 \"${fileBasename}\" -o \"${fileBasenameNoExtension}.exe\" && \"${fileBasenameNoExtension}.exe\" < input.txt > output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}